# Common Database Credentials (used by account, payment, transaction, user services)
DB_COMPUTE_ID=your_db_compute_id_here
DB_PASSWORD=your_db_password_here

# Auth Service Database Credentials
AUTH_COMPUTE_ID=your_auth_db_compute_id_here
AUTH_PASSWORD=your_auth_db_password_here
AUTH_NAME=auth_db_name_here

# Specific Database Names for other Microservices
ACCOUNT_NAME=account_db_name_here
PAYMENT_NAME=payment_db_name_here
TRANSACTION_NAME=transaction_db_name_here
USER_NAME=user_db_name_here

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# NATS Messaging System URL (inside Docker network)
NATS_URL=nats://nats:4222
